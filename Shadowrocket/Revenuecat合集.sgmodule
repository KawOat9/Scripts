[URL Rewrite]

^https:\/\/api\.revenuecat\.com\/.+\/(?:receipts|subscribers\/[^/]+(?:\/attributes)?)$ https://reven.lovebabyforever.workers.dev header

^https:\/\/api\.rc-backup\.com\/.+\/(?:receipts|subscribers\/[^/]+(?:\/attributes)?)$ https://rc-backup.lovebabyforever.workers.dev header

^https:\/\/rc\.visionarytech\.ltd\/.+\/(?:receipts|subscribers\/[^/]+(?:\/attributes)?)$ https://rc.lovebabyforever.workers.dev header

^https:\/\/revenue\.cuto\.app\/.+\/(?:receipts|subscribers\/[^/]+(?:\/attributes)?)$ https://revencuto.lovebabyforever.workers.dev header

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, rc.visionarytech.ltd, revenue.cuto.app