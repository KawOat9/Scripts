[Script]
PicsartPro = type=http-request, pattern=^https:\/\/api\.picsart\.com\/gw-v2\/shop\/subscription\/apple\/purchases, script-path=https://raw.githubusercontent.com/KawOat9/Scripts/main/PicsartPro.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.picsart.com