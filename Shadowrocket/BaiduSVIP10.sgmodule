#!name=BaiduCloud SVIP10 ✨
#!desc=Baidu Netdisk SVIP
#!author=🅚Ⓐ🅦Ⓞ🅐Ⓣ
#!category=🔐APP
#!openUrl=https://apps.apple.com/app/id547166701
#!icon=https://raw.githubusercontent.com/KawOat9/icons/main/baiducloud.png

[Rule]
# เพิ่ม Rule เพื่อให้แน่ใจว่า Traffic วิ่งผ่าน Proxy/Script
# เพื่อป้องกัน Baidu แอบใช้ QUIC หลุด proxy
DOMAIN-SUFFIX, baidu.com, PROXY
PROTOCOL, QUIC, REJECT

[Script]
# Baidu Netdisk SVIP Crack
BaiduSVIP = type=http-response, pattern=^https?:\/\/pan\.baidu\.com\/(api\/(user\/info|loginStatus|quota)|(rest\/2\.0\/)?membership\/user), requires-body=1, script-path=https://raw.githubusercontent.com/KawOat9/Scripts/main/BaiduSVIP10.js

[MITM]
hostname = %APPEND% pan.baidu.com