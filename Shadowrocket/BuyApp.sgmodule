#!name=BuyApp 𝕏
#!desc=对 BuyApp 深度学习探索;
#!author=AppStore[https://apps.apple.com],revenuecat[https://www.revenuecat.com]
#!icon=https://www.apple.com/v/app-store/c/images/overview/icon_appstore__ev0z770zyxoy_large_2x.png
#!date=2022-05-00 00:00:00

[Script]
#Revenuecat-系列 hostname = api.revenuecat.com, api.rc-backup.com
Reven = type=http-response, pattern=^https:\/\/(api\.revenuecat\.com|api\.rc-backup\.com)\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://he2o.vercel.app/Resource/Script/byapp.js, requires-body=true, max-size=-1, timeout=60

Reven = type=http-request, pattern=^https:\/\/(api\.revenuecat\.com|api\.rc-backup\.com)\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://he2o.vercel.app/Resource/Script/byapp.js, timeout=60

#iTunes-系列 hostname = buy.itunes.apple.com
iTunes = type=http-response, pattern=^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt, script-path=https://he2o.vercel.app/Resource/Script/byapp.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% buy.itunes.apple.com, api.revenuecat.com, api.rc-backup.com