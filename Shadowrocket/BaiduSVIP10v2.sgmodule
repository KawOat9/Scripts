#!name=BaiduCloud SVIP10 Ver.2 ✨
#!desc=Baidu Netdisk SVIP 1080P / 30T
#!author=KawOat.DEV
#!category=🔐APP
#!openUrl=https://apps.apple.com/app/id547166701
#!icon=https://raw.githubusercontent.com/KawOat9/icons/main/baiducloud.png

[Rule]
# เพิ่ม Rule เพื่อให้แน่ใจว่า Traffic วิ่งผ่าน Proxy/Script
DOMAIN-SUFFIX, baidu.com, PROXY
# บล็อค QUIC เพื่อบังคับให้แอปใช้ HTTP/HTTPS
PROTOCOL, QUIC, REJECT

[Script]
# บังคับ 1080p (แก้ URL)
BaiduStreaming10v2 = type=http-request, pattern=^https:\/\/pan\.baidu\.com\/api\/streaming, script-path=https://raw.githubusercontent.com/KawOat9/Scripts/main/BaiduSVIP10v2.js, timeout=60

# ปลอม SVIP / member / quota
BaiduSVIP10v2 = type=http-response, pattern=^https?:\/\/pan\.baidu\.com\/(api\/quota|rest\/.*\/membership\/user), requires-body=true, max-size=-1, script-path=https://raw.githubusercontent.com/KawOat9/Scripts/main/BaiduSVIP10v2.js, timeout=60

[MITM]
hostname = %APPEND% pan.baidu.com, afd.baidu.com