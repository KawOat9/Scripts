#!name = Photoroom ✨
#!desc = Unlock Photoroom App (Pro + Business + Ultra)
#!author = 🅚Ⓐ🅦Ⓞ🅐Ⓣ
#!icon = https://raw.githubusercontent.com/KawOat9/icons/main/Photoroom.png
#!category=🔐APP

[Script]
# 1. ปลดล็อกเฉพาะแอป (PhotoroomPro) - วางไว้บนสุดเพื่อให้ทำงานก่อน
PhotoroomPro_Unlock = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(receipts|subscribers)\/(?!(.*\/)),requires-body=1,script-path=https://raw.githubusercontent.com/KawOat9/Scripts/main/PhotoroomPro.js

# 2. ลบ ETag เพื่อป้องกันการจำค่าเดิม (ใช้สคริปต์ที่คุณมี)
RC_ETag_Cleaner = type=http-request,pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/v1\/(subscribers|receipts),script-path=https://raw.githubusercontent.com/KawOat9/Scripts/main/deleteHeaderNotif.js

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com