#!name=BaiduCloud SVIP10 Ver.2 ✨
#!desc=Baidu Netdisk SVIP 1080P / 30T
#!author=KawOat.DEV
#!icon=https://raw.githubusercontent.com/KawOat9/icons/main/baiducloud.png
#!tag=🔐APP
#!openUrl=https://apps.apple.com/app/id547166701

[Rule]
# เพิ่ม Rule เพื่อให้แน่ใจว่า Traffic วิ่งผ่าน Proxy/Script
#DOMAIN-SUFFIX,baidu.com,PROXY
# บล็อค QUIC เพื่อบังคับให้แอปใช้ HTTP/HTTPS
#PROTOCOL,QUIC,REJECT

[Script]
# บังคับ 1080p (แก้ URL)
http-request ^https:\/\/pan\.baidu\.com\/api\/streaming script-path=https://raw.githubusercontent.com/KawOat9/Scripts/main/BaiduSVIP10v2.js, timeout=60, tag=BaiduStreaming10v2

# ปลอม SVIP / member / quota
http-response ^https?:\/\/pan\.baidu\.com\/(api\/quota|rest\/.*\/membership\/user) script-path=https://raw.githubusercontent.com/KawOat9/Scripts/main/BaiduSVIP10v2.js, requires-body=true, timeout=60, tag=BaiduSVIP10v2

[MITM]
hostname = pan.baidu.com, afd.baidu.com