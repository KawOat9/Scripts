#!name=BaiduCloud SVIP10 Fix✨
#!desc=Baidu Netdisk SVIP
#!author=🅚Ⓐ🅦Ⓞ🅐Ⓣ
#!icon=https://raw.githubusercontent.com/KawOat9/icons/main/baiducloud.png
#!tag=🔐APP
#!openUrl=https://apps.apple.com/app/id547166701

[Rule]
# เพิ่ม Rule เพื่อให้แน่ใจว่า Traffic วิ่งผ่าน Proxy/Script
DOMAIN-SUFFIX,baidu.com,PROXY

[Script]
# Baidu Netdisk SVIP Crack
http-response ^https?:\/\/pan\.baidu\.com\/(api\/(user\/info|loginStatus|quota)|(rest\/2\.0\/)?membership\/user) script-path=https://raw.githubusercontent.com/KawOat9/Scripts/main/BaiduSVIP10Fix.js, requires-body=true, tag=BaiduSVIP10 Fix

#http-request ^https:\/\/pan\.baidu\.com\/api\/streaming\?app_id=\d+&type=M3U8_HQ_1080 script-path=https://raw.githubusercontent.com/KawOat9/Scripts/main/BaiduSVIP10v2.js, timeout=60, tag=BaiduStreaming10v2

#http-response ^https:\/\/pan\.baidu\.com\/rest\/.*\/membership\/user script-path=https://raw.githubusercontent.com/KawOat9/Scripts/main/BaiduSVIP10v2.js, requires-body=true, timeout=60, tag=BaiduSVIP10v2

[MITM]
hostname = pan.baidu.com