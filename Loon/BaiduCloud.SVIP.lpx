#http-response ^https:\/\/pan\.baidu\.com\/(rest\/2\.0\/membership\/user|api\/user\/getinfo) script-path=https://raw.githubusercontent.com/KawOat9/Scripts/main/BaiduSVIP10.js, requires-body=true, tag=BaiduSVIP10

#http-response ^https:\/\/pan\.baidu\.com\/(rest\/2\.0\/membership\/user|api\/user\/getinfo) script-path=https://raw.githubusercontent.com/KawOat9/Scripts/main/BaiduSVIP10v2.js, requires-body=true, tag=BaiduSVIP10v2

