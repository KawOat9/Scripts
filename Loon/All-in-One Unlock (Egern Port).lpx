#!name=All-in-One Unlock 🎉
#!desc=Ported Scripts from AppTesters
#!author=🅚Ⓐ🅦Ⓞ🅐Ⓣ
#!icon=https://raw.githubusercontent.com/KawOat9/icons/main/AppTesters.png
#!tag=🔐APP
#!system=ios

[Rewrite]
# RevenueCat Force Refresh (Delete ETag)
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del X-RevenueCat-ETag
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del x-revenuecat-etag

[Script]
# RevenueCat Universal
http-response ^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$) script-path=https://apptesters.org/egern/AutoRC.js, requires-body=true, tag=AppRCTesters

http-request ^https:\/\/api\.(revenuecat|rc-backup)\.com\/v1\/(subscribers|receipts) script-path=https://raw.githubusercontent.com/KawOat9/Scripts/main/deleteHeaderNotif.js, tag=RC_ETag_Cleaner

# Adapty
http-response https://api.adapty.io/api/v1/sdk/analytics/profiles script-path=https://apptesters.org/egern/Adapty.js, requires-body=true, tag=AppAdTesters

# Facemoji
http-response https://order.creativeappnow.com/iap/receipt script-path=https://apptesters.org/egern/Facemoji.js, requires-body=true, tag=AppFMTesters

# Readdle (PDF Expert etc)
http-response https:\/\/license\.pdfexpert\.com\/api\/2\.0\/(calendarslite|pdfexpert6|documents)\/subscription\/(refresh|check) script-path=https://apptesters.org/egern/readdle.js, requires-body=true, tag=AppReTesters

# iTunes Receipt
http-response ^https:\/\/buy\.itunes\.apple\.com\/verifyReceipt script-path=https://apptesters.org/egern/iTunes.js, requires-body=true, tag=AppitTesters

# Muslim Pro
http-response us-central1-muslim-pro-app.cloudfunctions.net/GetUserPremiumInfo script-path=https://apptesters.org/egern/MuslimPro.js, requires-body=true, tag=AppMuTesters

# Grammarly
http-response ^https?:\/\/subscription\.grammarly\.com\/api\/v1\/subscription$ script-path=https://apptesters.org/egern/Grammarly.js, requires-body=true, tag=AppGrTesters

# eSound
http-response api.esound.app/account script-path=https://apptesters.org/egern/eSound.js, requires-body=true, tag=AppeSTesters

# Purchasely
http-response https://api.purchasely.io/paab/user_purchases script-path=https://apptesters.org/egern/purchasely.js, requires-body=true, tag=AppPurTesters

# Vaia / StudySmarter
http-response prod.studysmarter.de/payments/info script-path=https://apptesters.org/egern/Vaia.js, requires-body=true, tag=AppVaTesters

# Qonversion
http-response api.qonversion.io/v1/user/init script-path=https://apptesters.org/egern/qonversion.js, requires-body=true, tag=AppQOTesters

# edjing Mix
http-response https://api.mwm-users.com/me/features script-path=https://apptesters.org/egern/edjingMix.js, requires-body=true, tag=AppDJTesters

# VivaCut
http-response https://api-fra.vivacut.com/api/rest/commerce/integrate/vip/perform script-path=https://apptesters.org/egern/VivaCut.js, requires-body=true, tag=AppVCTesters

# Carrot Weather
http-response https://carrotweather.herokuapp.com/parse/functions/findSubscriptionsForUserId script-path=https://apptesters.org/egern/Carrot.js, requires-body=true, tag=AppCaTesters

# KineMaster
http-response https://api-account.kinemasters.com/v2/user/subscribe script-path=https://apptesters.org/egern/KineMaster.js, requires-body=true, tag=AppKineTesters

# PicsArt (Note: This is http-request)
http-request https://api.picsart.com/gw-v2/shop/subscription/apple/purchases script-path=https://apptesters.org/egern/PicsArt.js, requires-body=true, tag=AppPicTesters

# Alight Motion
http-response https://us-central1-alight-creative.cloudfunctions.net/getAccountStatusAndLicenses script-path=https://apptesters.org/egern/AlightMotion.js, requires-body=true, tag=AppAMTesters

# Sandbox
http-response api.sandbox.love/accounts/current script-path=https://apptesters.org/egern/SandBox.js, requires-body=true, tag=AppSaTesters

# SongShift
http-response subscriptions.songshift.com/validate script-path=https://apptesters.org/egern/SongShift.js, requires-body=true, tag=AppSSesters

# AdblockPro
http-response api.adblockpro.app/verify script-path=https://apptesters.org/egern/AdblockPro.js, requires-body=true, tag=AppADBTesters

# AdGuard Pro
http-response ^https:\/\/mobile-api\.adguard\.org\/api\/.+\/ios_validate_receipt\/(.*?) script-path=https://apptesters.org/egern/AdGuardPro.js, requires-body=true, tag=AppADGTesters

[MITM]
hostname = api.revenuecat.com, buy.itunes.apple.com, api.picsart.com, api-account.kinemasters.com, us-central1-alight-creative.cloudfunctions.net, api.adapty.io, carrotweather.herokuapp.com, order.creativeappnow.com, api.mwm-users.com, us-central1-muslim-pro-app.cloudfunctions.net, prod.studysmarter.de, api.qonversion.io, subscription.grammarly.com, api.esound.app, api.purchasely.io, api.sandbox.love, subscriptions.songshift.com, api.adblockpro.app, mobile-api.adguard.org, license.pdfexpert.com, api-fra.vivacut.com