[Script]
http-request ^https:\/\/dm\.terabox\.com\/api\/streaming\?app_id=\d+&type=M3U8_HQ_1080 script-path=https://raw.githubusercontent.com/KawOat9/Scripts/main/%40TEST/Terabox.js, timeout=60, tag=BaiduStreaming10v2

http-response ^https:\/\/dm\.terabox\.com\/rest\/.*\/membership\/user script-path=https://raw.githubusercontent.com/KawOat9/Scripts/main/%40TEST/Terabox.js, requires-body=true, timeout=60, tag=BaiduSVIP10v2

[MITM]
hostname = dm.terabox.com